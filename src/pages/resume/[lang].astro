---
// Printable resume, one route per language (/resume/en/, /resume/pt/).
//
// Rendered entirely at build time from the same data files as the site
// (profile.ts, timeline.ts, skills.ts) — no client i18n, no Three.js, no
// scroll reveal. `npm run resume` prints these routes to the PDFs listed in
// profile.resume via headless Chrome (scripts/generate-resume.mjs). The layout
// must stay within ONE A4 page; the script fails the build otherwise.
//
// Order follows resume convention (reverse-chronological), not the site's
// oldest-first trajectory. `origin` and `now` nodes are omitted: the headline
// already says what is being looked for, and the schooling abroad is covered
// by the Spoken-languages skill row.

import type { LangCode } from '../../data/i18n/types';
import { deriveContent } from '../../data/i18n';
import { pick } from '../../data/localized';
import { formatRange } from '../../data/dates';
import { profile } from '../../data/profile';
import { nodes, repoHref, type TimelineNode } from '../../data/timeline';
import { skills } from '../../data/skills';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const lang = Astro.params.lang as LangCode;
const content = deriveContent(lang);

// Section labels are local to this page: the site has no "Education" /
// "Experience" chrome, so they don't belong in i18n/en.ts or pt.ts.
const labels = {
  education: { en: 'Education', pt: 'Formação' },
  experience: { en: 'Experience', pt: 'Experiência' },
  projects: { en: 'Projects', pt: 'Projetos' },
  skills: { en: 'Skills', pt: 'Competências' },
  title: { en: 'Resume', pt: 'Currículo' },
  coursework: { en: 'Relevant coursework', pt: 'Disciplinas relevantes' },
};

const site = Astro.site ?? new URL('https://luispazzanese.dev');
const siteHost = site.host;
const githubHandle = profile.github.replace(/^https?:\/\//, '');
const linkedinHandle = profile.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

/** Site-relative artifact hrefs (e.g. `/play`) must be absolute inside a PDF. */
const absolute = (href: string) => new URL(href, site).toString();

const byNewest = (a: TimelineNode, b: TimelineNode) => (a.start < b.start ? 1 : -1);
const education = nodes.find((n) => n.id === 'insper')!;
const clubs = nodes.filter((n) => n.kind === 'club').sort(byNewest);
const work = nodes.filter((n) => n.kind === 'work').sort(byNewest);
const projects = nodes.filter((n) => n.kind === 'project').sort(byNewest);

const t = (n: TimelineNode) => content.timeline[n.id];
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <title>{profile.shortName} — {pick(labels.title, lang)}</title>

    <!-- Same font stack as BaseLayout so the PDF matches the site. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <main class="sheet">
      <!-- Header -->
      <header class="head">
        <h1>{profile.name}</h1>
        <p class="headline">{content.profile.headline}</p>
        <p class="contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span class="sep">·</span>
          <a href={site.toString()}>{siteHost}</a>
          <span class="sep">·</span>
          <a href={profile.github}>{githubHandle}</a>
          <span class="sep">·</span>
          <a href={profile.linkedin}>{linkedinHandle}</a>
          <span class="sep">·</span>
          <span>{content.profile.location}</span>
        </p>
      </header>

      <!-- Education -->
      <section>
        <h2>{pick(labels.education, lang)}</h2>
        <article class="entry">
          <div class="entry-head">
            <h3>
              {t(education).role}
              <span class="org">· <a href={education.orgHref}>{education.org}</a></span>
            </h3>
            <span class="date">{formatRange(education.start, education.end, lang)}</span>
          </div>
          {t(education).summary && <p class="summary">{t(education).summary}</p>}
          <ul>
            {t(education).bullets.map((b) => <li>{b}</li>)}
            <li>
              {pick(labels.coursework, lang)}:{' '}
              {(education.coursework ?? [])
                .flatMap((term) => term.courses.filter((c) => c.highlight).map((c) => pick(c.name, lang)))
                .join(', ')}
              .
            </li>
          </ul>
        </article>
        {
          clubs.map((n) => (
            <article class="entry">
              <div class="entry-head">
                <h3>
                  {t(n).role}
                  {n.org && <span class="org">· {n.orgHref ? <a href={n.orgHref}>{n.org}</a> : n.org}</span>}
                </h3>
                <span class="date">{t(n).date}</span>
              </div>
              {(n.brief ?? n.bullets).length > 0 && (
                <ul>{(n.brief ?? n.bullets).map((b) => <li>{pick(b, lang)}</li>)}</ul>
              )}
            </article>
          ))
        }
      </section>

      <!-- Experience -->
      <section>
        <h2>{pick(labels.experience, lang)}</h2>
        {
          work.map((n) => (
            <article class="entry">
              <div class="entry-head">
                <h3>
                  {t(n).role}
                  {n.org && (
                    <span class="org">· {n.orgHref ? <a href={n.orgHref}>{n.org}</a> : n.org}</span>
                  )}
                </h3>
                <span class="date">{t(n).date}</span>
              </div>
              {t(n).summary && <p class="summary">{t(n).summary}</p>}
              {t(n).bullets.length > 0 && <ul>{t(n).bullets.map((b) => <li>{b}</li>)}</ul>}
            </article>
          ))
        }
      </section>

      <!-- Projects -->
      <section>
        <h2>{pick(labels.projects, lang)}</h2>
        {
          projects.map((n) => {
            const featured = (n.projects ?? []).filter((p) => p.featured);
            const rest = (n.projects ?? []).filter((p) => !p.featured);
            // The header already links GitHub; don't spend a line repeating it.
            const links = n.artifacts.filter((a) => a.href !== profile.github);
            return (
              <article class="entry">
                <div class="entry-head">
                  <h3>
                    {t(n).role}
                    {n.org && (
                      <span class="org">· {n.orgHref ? <a href={n.orgHref}>{n.org}</a> : n.org}</span>
                    )}
                  </h3>
                  <span class="date">{t(n).date}</span>
                </div>
                {(n.brief ?? n.bullets).length > 0 && (
                  <ul>{(n.brief ?? n.bullets).map((b) => <li>{pick(b, lang)}</li>)}</ul>
                )}

                {featured.length > 0 && (
                  <ul class="featured">
                    {featured.map((p) => (
                      <li>
                        <strong>{p.name}</strong> — {pick(p.brief ?? p.description, lang)}
                        {p.repo && (
                          <a class="repo" href={repoHref(p.repo)}>
                            {repoHref(p.repo).replace(/^https?:\/\//, '')}
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                {(rest.length > 0 || links.length > 0) && (
                  <p class="more">
                    {rest.map((p, i) => (
                      <>
                        {i > 0 && <span class="sep">·</span>}
                        {p.repo ? <a href={repoHref(p.repo)}>{p.name}</a> : p.name}
                      </>
                    ))}
                    {links.map((a, i) => (
                      <>
                        {(i > 0 || rest.length > 0) && <span class="sep">·</span>}
                        <a href={absolute(a.href)}>{pick(a.label, lang)} ↗</a>
                      </>
                    ))}
                  </p>
                )}
              </article>
            );
          })
        }
      </section>

      <!-- Skills -->
      <section>
        <h2>{pick(labels.skills, lang)}</h2>
        <dl class="skills">
          {
            skills.map((s) => (
              <>
                <dt>{content.skills[s.id].label}</dt>
                <dd>{content.skills[s.id].value}</dd>
              </>
            ))
          }
        </dl>
      </section>
    </main>
  </body>
</html>

<style>
  /*
   * Print-first. Sizes are in pt so the PDF is deterministic; the screen view
   * is just the same sheet centered on a grey backdrop.
   */
  :root {
    --ink: #111;
    --ink-muted: #444;
    --ink-dim: #777;
    --rule: #d0d0d0;
    --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  @page {
    size: A4;
    margin: 10mm 13mm;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: #e9e9e9;
  }

  body {
    font-family: var(--font-sans);
    font-size: 9pt;
    line-height: 1.22;
    color: var(--ink);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet {
    background: #fff;
    width: 210mm;
    min-height: 297mm;
    margin: 24px auto;
    padding: 12mm 14mm;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
  }

  @media print {
    html {
      background: #fff;
    }
    .sheet {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
    a {
      color: inherit;
    }
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .sep {
    color: var(--ink-dim);
    margin: 0 0.35em;
  }

  /* Header */
  .head {
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 7pt;
    margin-bottom: 8pt;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: 17pt;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .headline {
    margin-top: 3pt;
    font-size: 10.5pt;
    color: var(--ink-muted);
  }

  .contact {
    margin-top: 4pt;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--ink-muted);
  }

  .contact span:not(.sep) {
    white-space: nowrap;
  }

  /* Sections */
  section {
    margin-top: 7pt;
    break-inside: avoid;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 8.5pt;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2pt;
    margin-bottom: 5pt;
  }

  .entry + .entry {
    margin-top: 6pt;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12pt;
  }

  h3 {
    font-size: 10.5pt;
    font-weight: 600;
    line-height: 1.3;
  }

  .org {
    font-weight: 400;
    color: var(--ink-muted);
    white-space: nowrap; /* wrap "· Org" as a unit, never mid-name */
  }

  .date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 8.5pt;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .summary {
    margin-top: 1.5pt;
    color: var(--ink-muted);
  }

  ul {
    list-style: none;
    margin-top: 2pt;
  }

  li {
    position: relative;
    padding-left: 10pt;
    margin-top: 1.5pt;
  }

  li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--ink-dim);
  }

  .featured strong {
    font-weight: 600;
  }

  .repo {
    margin-left: 0.5em;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--ink-dim);
  }

  .more,
  .artifacts {
    margin-top: 2.5pt;
    font-family: var(--font-mono);
    font-size: 8.5pt;
    color: var(--ink-muted);
  }

  .more a,
  .artifacts a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2pt;
  }

  /* Skills: label column in mono, value in sans */
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 12pt;
    row-gap: 2pt;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 8.5pt;
    color: var(--ink-dim);
    padding-top: 1pt;
  }
</style>
