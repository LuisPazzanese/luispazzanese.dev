---
// Printable resume, one route per language (/resume/en/, /resume/pt/).
//
// Built from the same data files as the site (profile, projects, experience,
// education, skills) in the same datasheet look. `npm run resume` prints these
// routes to the PDFs in profile.resume via headless Chrome
// (scripts/generate-resume.mjs), which fails if a PDF is not exactly one A4 page.
//
// Section order follows resume convention for a student: education first,
// then the three proofs, work, the one-liners and keyword rows. Headings are
// plain words so ATS parsers recognise them; no em dashes anywhere.

import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import type { LangCode } from '../../data/i18n/types';
import { degreeLine } from '../../data/i18n';
import { pick, type L } from '../../data/localized';
import { formatRange } from '../../data/dates';
import { profile } from '../../data/profile';
import { figures, moreProjects } from '../../data/projects';
import { experience } from '../../data/experience';
import { keyCourses, beforeUniversity } from '../../data/education';
import { skills } from '../../data/skills';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const lang = Astro.params.lang as LangCode;
const p = (l: L) => pick(l, lang);

const labels = {
  education: { en: 'Education', pt: 'Formação' },
  projects: { en: 'Projects', pt: 'Projetos' },
  experience: { en: 'Experience', pt: 'Experiência' },
  more: { en: 'More projects', pt: 'Mais projetos' },
  skills: { en: 'Skills', pt: 'Competências' },
  courses: { en: 'Key courses', pt: 'Disciplinas-chave' },
  before: { en: 'Before', pt: 'Antes' },
  title: { en: 'Resume', pt: 'Currículo' },
};

const site = Astro.site ?? new URL('https://luispazzanese.dev');
const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const d = profile.degree;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <title>{profile.name} · {p(labels.title)}</title>
  </head>
  <body>
    <main class="sheet">
      <header class="head">
        <p class="focus">{p(profile.focus)}</p>
        <h1>{profile.name}</h1>
        <p class="sub">{degreeLine(lang)} · {p(profile.seeking)}</p>
        <p class="contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span class="sep">·</span>
          <a href={site.toString()}>{site.host}</a>
          <span class="sep">·</span>
          <a href={profile.github}>{strip(profile.github)}</a>
          <span class="sep">·</span>
          <a href={profile.linkedin}>{strip(profile.linkedin)}</a>
          <span class="sep">·</span>
          <span>{p(profile.location)}</span>
        </p>
      </header>

      <section>
        <h2>{p(labels.education)}</h2>
        <div class="entry">
          <div class="entry-head">
            <h3>{p(d.title)} · {d.school}</h3>
            <span class="date">{formatRange(d.start, d.graduation, lang)}</span>
          </div>
          <p><span class="k">{p(labels.courses)}</span> {keyCourses.map(p).join(' · ')}</p>
          <p><span class="k">{p(labels.before)}</span> {p(beforeUniversity)}</p>
        </div>
      </section>

      <section>
        <h2>{p(labels.projects)}</h2>
        {
          figures.map((f) => (
            <div class="entry">
              <div class="entry-head">
                <h3>
                  {p(f.title)} <span class="stack">{f.stack.join(' · ')}</span>
                </h3>
                <span class="date">
                  {f.links.length > 0 ? <a href={f.links[0]!.href}>{p(f.links[0]!.label)} ↗</a> : f.note && p(f.note)}
                </span>
              </div>
              <ul>
                <li>{p(f.spec)}</li>
                <li>{p(f.detail)}</li>
              </ul>
            </div>
          ))
        }
      </section>

      <section>
        <h2>{p(labels.experience)}</h2>
        {
          experience.map((e) => (
            <div class="entry">
              <div class="entry-head">
                <h3>
                  {p(e.role)} · {e.org}
                  {e.stack.length > 0 && <span class="stack">{e.stack.join(' · ')}</span>}
                </h3>
                <span class="date">{formatRange(e.start, e.end, lang)}</span>
              </div>
              <ul>
                <li>{p(e.line)}</li>
              </ul>
            </div>
          ))
        }
      </section>

      <section>
        <h2>{p(labels.more)}</h2>
        <div class="cols">
          {
            moreProjects.map((g) => (
              <div>
                <h4>{p(g.label)}</h4>
                <ul>
                  {g.items.map((it) => (
                    <li>
                      <strong>{it.href ? <a href={it.href}>{p(it.name)}</a> : p(it.name)}</strong>{it.status && <span class="status"> ({p(it.status)})</span>}: {p(it.line)}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2>{p(labels.skills)}</h2>
        <dl class="skills">
          {
            skills.map((s) => (
              <>
                <dt>{p(s.label)}</dt>
                <dd>{typeof s.value === 'string' ? s.value : p(s.value)}</dd>
              </>
            ))
          }
        </dl>
      </section>
    </main>
  </body>
</html>

<style>
  /* Print-first: sizes in pt so the PDF is deterministic; on screen the same
     sheet sits on a grey backdrop. Palette = the site's light tokens. */
  :root {
    --ink: #16181a;
    --muted: #5c6166;
    --rule: #d9dcd6;
    --accent: #1f7a4d;
    --sans: 'IBM Plex Sans', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
  }

  @page {
    size: A4;
    margin: 11mm 14mm;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: #e9e9e6;
  }

  body {
    font-family: var(--sans);
    font-size: 9.4pt;
    line-height: 1.32;
    color: var(--ink);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet {
    background: #fff;
    width: 210mm;
    min-height: 297mm;
    margin: 24px auto;
    padding: 11mm 14mm;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
  }

  @media print {
    html {
      background: #fff;
    }
    .sheet {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .sep {
    color: var(--rule);
    margin: 0 0.4em;
  }

  .head {
    padding-bottom: 8pt;
    border-bottom: 1.25pt solid var(--ink);
  }

  .focus {
    font-family: var(--mono);
    font-size: 8pt;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin-top: 2pt;
    font-size: 20pt;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .sub {
    margin-top: 4pt;
    color: var(--muted);
  }

  .contact {
    margin-top: 3pt;
    font-family: var(--mono);
    font-size: 7.8pt;
    color: var(--muted);
  }

  section {
    margin-top: 10pt;
    break-inside: avoid;
  }

  h2 {
    font-family: var(--mono);
    font-size: 8pt;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 2.5pt;
    margin-bottom: 5pt;
    border-bottom: 0.75pt solid var(--rule);
  }

  .entry + .entry {
    margin-top: 6pt;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12pt;
  }

  h3 {
    font-size: 10pt;
    font-weight: 600;
  }

  h4 {
    font-family: var(--mono);
    font-size: 7.5pt;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2pt;
  }

  .stack {
    margin-left: 6pt;
    font-family: var(--mono);
    font-size: 7.5pt;
    font-weight: 400;
    color: var(--muted);
  }

  .date {
    flex: none;
    font-family: var(--mono);
    font-size: 7.8pt;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry > p {
    margin-top: 2pt;
  }

  .k {
    font-family: var(--mono);
    font-size: 7.5pt;
    color: var(--muted);
    margin-right: 4pt;
  }

  ul {
    list-style: none;
    margin-top: 2pt;
  }

  li {
    position: relative;
    padding-left: 9pt;
    margin-top: 1.5pt;
  }

  li::before {
    content: '';
    position: absolute;
    left: 1pt;
    top: 0.55em;
    width: 3pt;
    height: 3pt;
    background: var(--accent);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 16pt;
  }

  .cols li {
    font-size: 8.6pt;
  }

  .cols strong {
    font-weight: 600;
  }

  .status {
    color: var(--accent);
  }

  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 14pt;
    row-gap: 2pt;
  }

  dt {
    font-family: var(--mono);
    font-size: 7.8pt;
    color: var(--muted);
    padding-top: 1pt;
  }
</style>
