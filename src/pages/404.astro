---
// Not-found page. Served statically by Cloudflare Pages for unknown routes;
// rendered in Portuguese only, like the root route.
import BaseLayout from '../layouts/BaseLayout.astro';
import { translations } from '../data/i18n';

const t = translations.pt.notFound;
---

<BaseLayout lang="pt" title="404 · página não encontrada" description="Rota não encontrada." path="/404">
  <main class="container nf">
    <p class="label">404</p>
    <h1>{t.heading}</h1>
    <p>{t.body}</p>
    <a href="/">← {t.backHome}</a>
  </main>
</BaseLayout>

<style>
  .nf {
    padding-top: 96px;
  }

  h1 {
    margin: 8px 0;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
  }

  p + a {
    display: inline-block;
    margin-top: 16px;
  }
</style>
