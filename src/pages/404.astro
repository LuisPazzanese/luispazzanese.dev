---
// Not-found page. Served statically by Cloudflare Pages for unknown routes;
// rendered in English only (no language alternates for an error page).
import BaseLayout from '../layouts/BaseLayout.astro';
import { translations } from '../data/i18n';

const t = translations.en.notFound;
---

<BaseLayout lang="en" title="404 — page not found" description="Route not found." path="/404">
  <main class="container nf">
    <p class="mono nf__code" aria-hidden="true">{t.code}</p>
    <h1 class="nf__heading">{t.heading}</h1>
    <p class="nf__body">{t.body}</p>
    <a href="/" aria-label={t.backHomeAria}>← {t.backHome}</a>
  </main>
</BaseLayout>

<style>
  .nf {
    padding-top: 32px;
  }

  .nf__code {
    color: var(--fg-2);
    margin-bottom: 8px;
  }

  .nf__heading {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .nf__body {
    max-width: 60ch;
    margin-bottom: 16px;
  }
</style>
