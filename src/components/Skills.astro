---
// Rows come from src/data/skills.ts; the derived strings live under
// translations.<lang>.skills.<id>.{label,value}.
import { skills } from '../data/skills';
import { translations } from '../data/i18n';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <h2 id="skills-heading">{t.sections.skills}</h2>

    <dl class="skills">
      {
        skills.map((s) => (
          <div class="skills__row">
            <dt>{t.skills[s.id].label}</dt>
            <dd>{t.skills[s.id].value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* The <dl> is the grid; each row's wrapper is `display: contents` so dt/dd
     land in the label/value columns directly. */
  .skills {
    display: grid;
    grid-template-columns: 136px 1fr;
    gap: 8px 16px;
  }

  .skills__row {
    display: contents;
  }

  .skills__row dt {
    font-weight: 700;
  }

  .skills__row dd {
    overflow-wrap: anywhere;
  }

  /* Phones: label above value, 8px between rows only. */
  @media (max-width: 600px) {
    .skills {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .skills__row + .skills__row dt {
      margin-top: 8px;
    }
  }
</style>
