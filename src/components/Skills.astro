---
// Keyword rows: label | value. Data in src/data/skills.ts.
import { skills } from '../data/skills';
import { pick } from '../data/localized';
import { translations, type LangCode } from '../data/i18n';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section class="section container" aria-labelledby="skills-h">
  <h2 id="skills-h" class="label">{t.sections.skills}</h2>
  <dl class="rows">
    {
      skills.map((s) => (
        <>
          <dt class="label">{pick(s.label, lang)}</dt>
          <dd>{typeof s.value === 'string' ? s.value : pick(s.value, lang)}</dd>
        </>
      ))
    }
  </dl>
</section>
