---
// Rows come from src/data/skills.ts; the derived strings live under
// translations.<lang>.skills.<id>.{label,value}.
import { skills } from '../data/skills';
import { translations } from '../data/i18n';

const en = translations.en;
---

<section id="skills" class="reveal" aria-labelledby="skills-heading">
  <div class="container">
    <h2 id="skills-heading" data-i18n="sections.skills">{en.sections.skills}</h2>

    <dl class="skills">
      {
        skills.map((s) => (
          <div class="skills__row">
            <dt data-i18n={`skills.${s.id}.label`}>{en.skills[s.id].label}</dt>
            <dd data-i18n={`skills.${s.id}.value`}>{en.skills[s.id].value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    margin: 2rem 0 0;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    overflow-x: auto;
  }

  .skills__row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding: 0.35rem 0;
  }

  .skills__row dt {
    color: var(--accent);
    font-weight: 500;
  }

  .skills__row dt::after {
    content: ':';
    color: var(--fg-dim);
  }

  .skills__row dd {
    margin: 0;
    color: var(--fg);
  }

  @media (max-width: 520px) {
    .skills__row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
      padding: 0.4rem 0;
    }
  }
</style>
