---
// Trajectory: one vertical rail, oldest node at the top, "now" at the bottom.
// Every string comes from src/data/timeline.ts via translations.en; the
// data-i18n keys mirror the record shape (timeline.<id>.bullets.0, ...).
// To change content, edit the data file — this component only lays it out.
//
// Layout: ≥900px a two-column grid per node (date gutter | content) with the
// rail between them; below that, a single column with the rail on the left and
// the date above the role. The marker on the rail encodes `kind`.
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { nodes, archive, repoHref, type Media } from '../data/timeline';
import { translations } from '../data/i18n';

const en = translations.en;

// Media files are dropped into public/media/ by hand (see public/media/README.md).
// Render only what exists so a missing photo produces nothing, not a broken image.
const publicDir = fileURLToPath(new URL('../../public/', import.meta.url));
const exists = (src: string) => fs.existsSync(path.join(publicDir, src));
const available = (media: Media[] | undefined) =>
  (media ?? []).map((m, i) => ({ m, i })).filter(({ m }) => exists(m.src));
---

<section id="timeline" class="reveal" aria-labelledby="timeline-heading">
  <div class="container">
    <h2 id="timeline-heading" data-i18n="sections.timeline">{en.sections.timeline}</h2>

    <ol class="rail">
      {
        nodes.map((node) => {
          const t = en.timeline[node.id];
          const featured = (node.projects ?? []).filter((p) => p.featured);
          const rest = (node.projects ?? []).filter((p) => !p.featured);
          const media = available(node.media);
          return (
            <li class={`node node--${node.kind}`}>
              <div class="node__meta">
                <span class="node__date" data-i18n={`timeline.${node.id}.date`}>{t.date}</span>
                {node.kind !== 'now' && (
                  <span class="node__kind" data-i18n={`ui.kind.${node.kind}`}>{en.ui.kind[node.kind]}</span>
                )}
              </div>

              <article id={node.id} class="node__body">
                <header class="node__head">
                  <h3 class="node__role" data-i18n={`timeline.${node.id}.role`}>{t.role}</h3>
                  {node.org && (
                    <span class="node__org">
                      {node.orgHref ? (
                        <a href={node.orgHref} target="_blank" rel="noopener noreferrer">{node.org}</a>
                      ) : (
                        node.org
                      )}
                    </span>
                  )}
                </header>

                {t.summary && <p class="node__summary" data-i18n={`timeline.${node.id}.summary`}>{t.summary}</p>}

                {media.length > 0 && (
                  <div class="media">
                    {media.map(({ m, i }) => (
                      <figure class={`media__item media__item--${m.kind}`}>
                        {m.kind === 'video' ? (
                          <video
                            controls
                            preload="none"
                            playsinline
                            poster={m.poster && exists(m.poster) ? m.poster : undefined}
                            aria-label={t.media[i]}
                            data-i18n-aria={`timeline.${node.id}.media.${i}`}
                          >
                            <source src={m.src} type="video/mp4" />
                          </video>
                        ) : (
                          <img
                            src={m.src}
                            alt={t.media[i]}
                            loading="lazy"
                            decoding="async"
                            data-i18n={`timeline.${node.id}.media.${i}`}
                            data-i18n-attr="alt"
                          />
                        )}
                      </figure>
                    ))}
                  </div>
                )}

                {t.bullets.length > 0 && (
                  <ul class="node__bullets">
                    {t.bullets.map((b, i) => <li data-i18n={`timeline.${node.id}.bullets.${i}`}>{b}</li>)}
                  </ul>
                )}

                {node.coursework && (
                  <dl class="coursework">
                    {node.coursework.map((term, ti) => (
                      <>
                        <dt>{term.term}</dt>
                        <dd>
                          {term.courses.map((c, ci) => (
                            <>
                              {ci > 0 && <span aria-hidden="true"> · </span>}
                              <span class={c.highlight ? 'hi' : undefined} data-i18n={`timeline.${node.id}.coursework.${ti}.${ci}`}>
                                {t.coursework[ti][ci]}
                              </span>
                            </>
                          ))}
                        </dd>
                      </>
                    ))}
                  </dl>
                )}

                {featured.length > 0 && (
                  <ul class="node__projects">
                    {featured.map((p) => {
                      const key = p.repo ?? p.name;
                      return (
                        <li class="project">
                          <h4 class="project__name">
                            {p.repo ? (
                              <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">{p.name}</a>
                            ) : (
                              p.name
                            )}
                          </h4>
                          <ul class="chips project__stack" aria-label="Stack">
                            {p.stack.map((s) => <li>{s}</li>)}
                          </ul>
                          <p class="project__desc" data-i18n={`timeline.${node.id}.projects.${key}`}>{t.projects[key]}</p>
                        </li>
                      );
                    })}
                  </ul>
                )}

                {rest.length > 0 && (
                  <p class="node__also">
                    <span class="node__also-label" data-i18n="ui.alsoLabel">{en.ui.alsoLabel}</span>:
                    {rest.map((p, i) => (
                      <>
                        {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                        {p.repo ? (
                          <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">{p.name}</a>
                        ) : (
                          <span>{p.name}</span>
                        )}
                      </>
                    ))}
                  </p>
                )}

                {node.artifacts.length > 0 && (
                  <p class="node__artifacts">
                    {node.artifacts.map((a, i) => (
                      <a
                        href={a.href}
                        target={a.href.startsWith('/') || a.href.startsWith('mailto:') ? undefined : '_blank'}
                        rel={a.href.startsWith('/') || a.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                        data-i18n={`timeline.${node.id}.artifacts.${i}`}
                      >
                        {t.artifacts[i]}
                      </a>
                    ))}
                  </p>
                )}

                {node.tags.length > 0 && (
                  <ul class="chips chips--tags" aria-label="Tags">
                    {node.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </article>
            </li>
          );
        })
      }
    </ol>

    <h3 class="archive__title" data-i18n="sections.archive">{en.sections.archive}</h3>
    <ul class="archive">
      {
        archive.map((p) => {
          const key = p.repo ?? p.name;
          return (
            <li>
              <span class="archive__name">
                {p.repo ? (
                  <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">{p.name}</a>
                ) : (
                  p.name
                )}
              </span>
              <span class="archive__desc" data-i18n={`archive.${key}`}>{en.archive[key]}</span>
              <span class="archive__stack">{p.stack.join(' · ')}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* ---- Rail: `--rail-x` is the x of the 1px line inside .rail; the marker is
     centred on it. Mobile: line on the left edge. Wide: between gutter and
     content (see the min-width block at the end). */
  .rail {
    --rail-x: 4px;
    --rail-gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: var(--space-heading) 0 0;
    position: relative;
  }

  .rail::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: var(--rail-x);
    width: 1px;
    background: var(--line-strong);
  }

  .node {
    position: relative;
    padding: 0 0 3.5rem calc(var(--rail-x) + var(--rail-gap));
  }

  .node:last-child { padding-bottom: 0; }

  /* ---- Marker: one shape per kind. origin ○ dim · education □ · work ● ·
     club ○ accent · project ◇ accent · now ● accent, pulsing. */
  .node::before {
    content: '';
    position: absolute;
    left: calc(var(--rail-x) - 4px);
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--fg-dim);
  }

  .node--origin::before { border-color: var(--line-strong); }
  .node--education::before { border-radius: 1px; border-color: var(--fg-muted); }
  .node--work::before { background: var(--fg-muted); border-color: var(--fg-muted); }
  .node--club::before { border-color: var(--accent-dim); }

  .node--project::before {
    border-radius: 1px;
    border-color: var(--accent-dim);
    background: var(--accent-soft);
    transform: rotate(45deg);
  }

  .node--now::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    50% { box-shadow: 0 0 0 7px var(--accent-soft); }
  }

  /* ---- Gutter: date + kind label ---------------------------------------- */
  .node__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    margin-bottom: 0.35rem;
  }

  .node__date { color: var(--fg-muted); }
  .node__kind { color: var(--fg-dim); font-size: 0.7rem; letter-spacing: 0.08em; }
  .node--now .node__date,
  .node--now .node__role { color: var(--accent); }

  /* ---- Body ---------------------------------------------------------------- */
  .node__body {
    /* Anchor offset so #zagros etc. don't hide under the browser chrome. */
    scroll-margin-top: 2rem;
    min-width: 0;
  }

  .node__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.6rem;
  }

  .node__role { font-size: 1.1rem; color: var(--fg); }
  .node__org { font-family: var(--font-mono); font-size: 0.85rem; color: var(--fg-muted); }
  .node__org::before { content: '@ '; color: var(--fg-dim); }
  .node__org a { color: var(--accent); border-bottom-color: transparent; }

  .node__summary {
    color: var(--fg-muted);
    font-size: 0.95rem;
    max-width: 62ch;
    margin-bottom: 0.9rem;
  }

  .node__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 0.9rem;
    display: grid;
    gap: 0.4rem;
    max-width: 68ch;
  }

  .node__bullets li {
    padding-left: 1.1rem;
    position: relative;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .node__bullets li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent-dim);
    font-family: var(--font-mono);
  }

  /* ---- Media strip: photos as a grid of 3:2 thumbs, a video full-width ---- */
  .media {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
    max-width: 68ch;
    margin: 0 0 1rem;
  }

  .media__item {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .media__item--video { grid-column: 1 / -1; }
  .media__item img,
  .media__item video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .media__item img { aspect-ratio: 3 / 2; }
  .media__item video { aspect-ratio: 16 / 9; background: #000; }

  /* ---- Featured project cards: name | stack on one row, description below -- */
  .node__projects {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0.9rem;
    display: grid;
    gap: 0.6rem;
  }

  .project {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .project__name { font-family: var(--font-mono); font-size: 0.95rem; font-weight: 600; }
  .project__name a { border-bottom-color: transparent; }
  .project__stack { justify-self: end; }
  .project__desc { grid-column: 1 / -1; font-size: 0.9rem; color: var(--fg-muted); }

  /* Links that hide their underline until hovered/focused. */
  .node__org a:hover,
  .node__org a:focus-visible,
  .project__name a:hover,
  .project__name a:focus-visible { border-bottom-color: var(--accent); }

  /* ---- Chips (stack / tags) ------------------------------------------------ */
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .chips li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--fg-dim);
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .chips--tags { margin-top: 0.9rem; }

  /* ---- Coursework: one row per semester, term in the left column. Courses
     that back the thesis keep contrast; the rest are dimmed, not hidden. */
  .coursework {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 1rem;
    margin: 0.75rem 0 0.5rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }

  .coursework dt { font-family: var(--font-mono); }
  .coursework dd { margin: 0; }
  .coursework .hi { color: var(--fg-muted); }

  /* ---- Secondary lines: "also:" and artifacts ------------------------------ */
  .node__also,
  .node__artifacts {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-dim);
    margin-bottom: 0.4rem;
  }

  .node__also a { color: var(--fg-muted); border-bottom-color: var(--line-strong); }
  .node__artifacts a { margin-right: 1.25rem; color: var(--accent-dim); border-bottom-color: transparent; }

  .node__also a:hover,
  .node__also a:focus-visible,
  .node__artifacts a:hover,
  .node__artifacts a:focus-visible { color: var(--accent); border-bottom-color: var(--accent); }

  /* ---- Archive: one row per repo, name · description · stack --------------- */
  .archive__title {
    margin-top: 4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
    text-transform: lowercase;
  }

  .archive {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .archive li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }

  .archive__name { font-family: var(--font-mono); }
  .archive__desc { color: var(--fg-muted); }
  .archive__stack { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-dim); }

  /* ---- Phones: single-column cards and coursework -------------------------- */
  @media (max-width: 600px) {
    .project { grid-template-columns: 1fr; }
    .project__stack { justify-self: start; order: 3; }
    .coursework { grid-template-columns: 1fr; gap: 0.1rem; }
    .coursework dd { margin-bottom: 0.4rem; }
  }

  /* ---- Wide: date gutter | rail | content ---------------------------------- */
  @media (min-width: 900px) {
    .rail {
      --rail-x: calc(var(--gutter) + 1.5rem);
      --rail-gap: 1.75rem;
    }

    .node {
      display: grid;
      grid-template-columns: var(--gutter) 1fr;
      column-gap: calc(var(--rail-x) + var(--rail-gap) - var(--gutter));
      padding-left: 0;
    }

    .node__meta {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 0;
      margin: 0;
      /* Align the date's baseline with the role's. */
      padding-top: 0.2rem;
    }
  }
</style>
