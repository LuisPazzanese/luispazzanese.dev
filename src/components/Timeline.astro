---
// Trajectory: one row per node, oldest at the top. Only the year label and the
// one-sentence `lead` are visible; everything else (role, org, summary,
// bullets, projects, coursework, artifacts, photos) sits inside a native
// <details>. Content comes from src/data/timeline.ts via translations[lang];
// this component only lays it out.
import { nodes, archive, repoHref, type TimelineNode } from '../data/timeline';
import { translations } from '../data/i18n';
import { availableMedia, mediaExists } from '../lib/media';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = translations[lang];

// '2023-08' / '2028-12' → '2023–2028'; end 'present' → '2026–'; same year or no end → '2025'.
function yearLabel(node: TimelineNode): string {
  const startYear = node.start.slice(0, 4);
  if (node.end === 'present') return `${startYear}–`;
  if (node.end === null) return startYear;
  const endYear = node.end.slice(0, 4);
  return endYear > startYear ? `${startYear}–${endYear}` : startYear;
}

const external = (href: string) => !(href.startsWith('/') || href.startsWith('mailto:'));
---

<!-- data-timeline + the two labels are hooks for the JS-only "open all"
     button (src/scripts/enhance.ts); without JS nothing is rendered in .head
     besides the heading. -->
<section
  id="timeline"
  aria-labelledby="timeline-heading"
  data-timeline
  data-open-all={t.ui.openAll}
  data-close-all={t.ui.closeAll}
>
  <div class="container">
    <div class="head">
      <h2 id="timeline-heading">{t.sections.timeline}</h2>
    </div>

    <ol class="rows">
      {
        nodes.map((node) => {
          const n = t.timeline[node.id];
          const featured = (node.projects ?? []).filter((p) => p.featured);
          const rest = (node.projects ?? []).filter((p) => !p.featured);
          const media = availableMedia(node.media);
          // Only highlighted courses, grouped by term; terms without any are dropped.
          const coursework = (node.coursework ?? [])
            .map((term, ti) => ({
              term: term.term,
              courses: term.courses.flatMap((c, ci) => (c.highlight ? [n.coursework[ti][ci]] : [])),
            }))
            .filter((term) => term.courses.length > 0);
          return (
            <li class="row" id={node.id}>
              <span class="row__year mono">{yearLabel(node)}</span>

              <div class="row__body">
                <p class="row__lead">{n.lead}</p>

                <details>
                  <summary>{t.ui.details}</summary>
                  <div class="more">
                    <p class="more__role">
                      <strong>{n.role}</strong>
                      {node.org && (
                        <>
                          {' — '}
                          {node.orgHref ? (
                            <a href={node.orgHref} target="_blank" rel="noopener noreferrer">{node.org}</a>
                          ) : (
                            node.org
                          )}
                        </>
                      )}
                    </p>

                    {n.summary && <p>{n.summary}</p>}

                    {n.bullets.length > 0 && (
                      <ul class="more__bullets">
                        {n.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    )}

                    {featured.length > 0 && (
                      <ul class="more__projects">
                        {featured.map((p) => {
                          const key = p.repo ?? p.name;
                          return (
                            <li>
                              <p>
                                {p.repo ? (
                                  <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">
                                    <strong>{p.name}</strong>
                                  </a>
                                ) : (
                                  <strong>{p.name}</strong>
                                )}
                                {' — '}
                                {n.projects[key]}
                              </p>
                              <p class="more__meta">
                                {p.repo && (
                                  <>
                                    {t.ui.repoLabel}: <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">{p.repo}</a>
                                    {' · '}
                                  </>
                                )}
                                {p.stack.join(' · ')}
                              </p>
                            </li>
                          );
                        })}
                      </ul>
                    )}

                    {rest.length > 0 && (
                      <p class="more__meta">
                        {t.ui.alsoLabel}:{' '}
                        {rest.map((p, i) => (
                          <>
                            {i > 0 && ' · '}
                            {p.repo ? (
                              <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">{p.name}</a>
                            ) : (
                              p.name
                            )}
                          </>
                        ))}
                      </p>
                    )}

                    {coursework.map((term) => (
                      <p class="more__meta">
                        {term.term} — {term.courses.join(' · ')}
                      </p>
                    ))}

                    {node.artifacts.length > 0 && (
                      <p class="more__meta">
                        {node.artifacts.map((a, i) => (
                          <>
                            {i > 0 && ' · '}
                            <a
                              href={a.href}
                              target={external(a.href) ? '_blank' : undefined}
                              rel={external(a.href) ? 'noopener noreferrer' : undefined}
                            >
                              {n.artifacts[i]}
                            </a>
                          </>
                        ))}
                      </p>
                    )}

                    {media.map(({ m, i }) => (
                      <figure class="more__media">
                        {m.kind === 'video' ? (
                          <video
                            controls
                            preload="none"
                            playsinline
                            poster={m.poster && mediaExists(m.poster) ? m.poster : undefined}
                            aria-label={n.media[i]}
                          >
                            <source src={m.src} type="video/mp4" />
                          </video>
                        ) : (
                          <img src={m.src} alt={n.media[i]} loading="lazy" decoding="async" />
                        )}
                      </figure>
                    ))}
                  </div>
                </details>
              </div>
            </li>
          );
        })
      }
    </ol>

    <h3 class="archive__title">{t.sections.archive}</h3>
    <ul class="archive">
      {
        archive.map((p) => {
          const key = p.repo ?? p.name;
          return (
            <li>
              {p.repo ? (
                <a href={repoHref(p.repo)} target="_blank" rel="noopener noreferrer">{p.name}</a>
              ) : (
                p.name
              )}
              {' — '}
              {t.archive[key]}
              <span class="archive__stack"> · {p.stack.join(' · ')}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Heading row; the JS-added toggle sits at its right end. */
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .head :global(.toggle-all) {
    flex-shrink: 0;
    margin-bottom: 16px; /* same as h2 */
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 15px;
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
  }

  .head :global(.toggle-all:hover) {
    color: var(--accent-hover);
  }

  .head :global(.toggle-all:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  /* Year column | body; rows separated by hairlines. */
  .row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .row__year {
    color: var(--fg-2);
    line-height: 1.6;
    padding-top: 2px; /* optical alignment with the 17px lead */
  }

  .row__lead {
    font-size: 17px;
  }

  @media (max-width: 699px) {
    .row {
      grid-template-columns: 1fr;
      gap: 4px 0;
    }
  }

  /* Everything inside <details>: 15px, 8px between blocks. */
  .more {
    font-size: 15px;
  }

  .more > * + * {
    margin-top: 8px;
  }

  .more__bullets {
    padding-left: 20px;
    list-style: disc;
  }

  .more__projects {
    list-style: none;
    padding-left: 0;
  }

  .more__projects > li + li {
    margin-top: 8px;
  }

  .more__meta {
    color: var(--fg-2);
  }

  .more__media {
    max-width: 320px;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }

  .more__media > img,
  .more__media > video {
    width: 100%;
    height: auto;
  }

  .archive__title {
    margin-top: 32px;
    margin-bottom: 8px;
  }

  .archive {
    font-size: 15px;
    padding-left: 20px;
  }

  .archive > li + li {
    margin-top: 4px;
  }

  .archive__stack {
    color: var(--fg-2);
  }
</style>
