---
import { profile } from '../data/profile';
import { translations } from '../data/i18n';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = translations[lang];
const year = new Date().getFullYear();
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<section id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <h2 id="contact-heading">{t.sections.contact}</h2>

    <dl class="contact">
      <div>
        <dt>{t.contact.emailLabel}</dt>
        <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
      </div>
      <div>
        <dt>{t.contact.linkedinLabel}</dt>
        <dd>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{bare(profile.linkedin)}</a>
        </dd>
      </div>
      <div>
        <dt>{t.contact.githubLabel}</dt>
        <dd>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">{bare(profile.github)}</a>
        </dd>
      </div>
      <div>
        <dt>{t.contact.locationLabel}</dt>
        <dd>{t.profile.location}</dd>
      </div>
    </dl>

    <footer class="footer">
      <span>© {year} {profile.shortName}</span>
      <span class="footer__sep" aria-hidden="true">·</span>
      <span>{t.contact.footer}</span>
    </footer>
  </div>
</section>

<style>
  /* Four cards: 2×2 on anything wider than a phone, stacked below. */
  .contact {
    margin: var(--space-heading) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .contact > div {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .contact dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
  }

  .contact dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-dim);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer__sep {
    color: var(--line-strong);
  }

  @media (max-width: 600px) {
    .footer {
      flex-direction: column;
      gap: 0.25rem;
    }
    .footer__sep {
      display: none;
    }
  }
</style>
