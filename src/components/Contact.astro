---
import { profile } from '../data/profile';
import { translations } from '../data/i18n';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = translations[lang];
const year = new Date().getFullYear();
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<section id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <h2 id="contact-heading">{t.sections.contact.toUpperCase()}</h2>

    <dl class="contact">
      <div>
        <dt>{t.contact.emailLabel}</dt>
        <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
      </div>
      <div>
        <dt>{t.contact.linkedinLabel}</dt>
        <dd>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{bare(profile.linkedin)}</a>
        </dd>
      </div>
      <div>
        <dt>{t.contact.githubLabel}</dt>
        <dd>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">{bare(profile.github)}</a>
        </dd>
      </div>
      <div>
        <dt>{t.contact.locationLabel}</dt>
        <dd>{t.profile.location}</dd>
      </div>
    </dl>

    <footer class="footer">
      <span>© {year} {profile.shortName}</span>
      <span class="footer__sep" aria-hidden="true">·</span>
      <span>{t.contact.footer}</span>
    </footer>
  </div>
</section>

<style>
  /* Same 136px label column as Skills. */
  .contact {
    display: grid;
    grid-template-columns: 136px 1fr;
    gap: 8px 16px;
  }

  .contact > div {
    display: contents;
  }

  .contact dt {
    font-weight: 700;
  }

  .contact dd {
    overflow-wrap: anywhere;
  }

  @media (max-width: 699px) {
    .contact {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .contact > div + div dt {
      margin-top: 8px;
    }
  }

  .footer {
    margin-top: 32px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--fg-2);
  }
</style>
