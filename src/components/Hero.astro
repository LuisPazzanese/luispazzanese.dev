---
// Card: photo + name + headline + facts + buttons. Everything comes from
// src/data/profile.ts (via translations[lang] for the localized strings).
// Edit the data file, not this component.
import { profile } from '../data/profile';
import { translations } from '../data/i18n';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<header class="card container">
  <img
    class="card__photo"
    src={profile.photo}
    alt={t.hero.photoAlt}
    width="128"
    height="128"
    decoding="async"
  />

  <div class="card__text">
    <h1 class="card__name">{profile.name}</h1>

    <!-- The one sentence a recruiter reads. -->
    <p class="card__headline">{t.profile.headline}</p>

    <!-- What / how much / where / when / English. -->
    <p class="card__facts">{t.profile.facts.join(' · ')}</p>

    <nav class="card__actions" aria-label={t.nav.primary}>
      <a class="button" href={t.profile.resumeHref} download>{t.hero.linkCV}</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{t.hero.linkLinkedin}</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">{t.hero.linkGithub}</a>
      <a href={`mailto:${profile.email}`}>{t.hero.linkEmail}</a>
    </nav>
  </div>
</header>

<style>
  .card {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    padding-top: 24px;
  }

  .card__photo {
    flex: 0 0 128px;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
  }

  .card__name {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .card__headline {
    font-size: 19px;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .card__facts {
    font-size: 15px;
    color: var(--fg-2);
    margin-bottom: 24px;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }

  /* The only button on the page: white on accent, 44px tall. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 20px;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .button:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  /* Phones: photo above the text, centred; buttons stacked full width. */
  @media (max-width: 600px) {
    .card {
      flex-direction: column;
      align-items: center;
      gap: 16px;
      text-align: center;
    }

    .card__photo {
      flex-basis: 96px;
      width: 96px;
      height: 96px;
    }

    .card__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
  }
</style>
