---
// Hero: everything here comes from src/data/profile.ts (via translations.en
// for the derived strings). Edit the data file, not this component.
import PcbBackground from './PcbBackground.astro';
import { profile } from '../data/profile';
import { translations } from '../data/i18n';

const en = translations.en;
---

<header class="hero">
  <PcbBackground />

  <div class="container hero__inner">
    <p class="hero__eyebrow" data-i18n="hero.eyebrow">{en.hero.eyebrow}</p>

    <h1 class="hero__name">{profile.name}</h1>

    <p class="hero__headline" data-i18n="profile.headline">{en.profile.headline}</p>
    <p class="hero__pitch" data-i18n="profile.pitch">{en.profile.pitch}</p>

    <ul class="hero__focus" aria-label="Focus areas">
      {en.profile.focus.map((f, i) => <li data-i18n={`profile.focus.${i}`}>{f}</li>)}
    </ul>

    <p class="hero__degree" data-i18n="profile.degreeLine">{en.profile.degreeLine}</p>

    <nav class="hero__links" aria-label={en.nav.primary} data-i18n-aria="nav.primary">
      <a href={profile.github} target="_blank" rel="noopener noreferrer" data-i18n="hero.linkGithub">{en.hero.linkGithub}</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-i18n="hero.linkLinkedin">{en.hero.linkLinkedin}</a>
      <a href={`mailto:${profile.email}`} data-i18n="hero.linkEmail">{en.hero.linkEmail}</a>
      <a href={en.profile.resumeHref} target="_blank" rel="noopener noreferrer" data-i18n="profile.resumeHref" data-i18n-attr="href"><span data-i18n="hero.linkCV">{en.hero.linkCV}</span></a>
    </nav>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    border-top: none;
    /* Override section spacing inherited from global.css */
    padding: 6rem 0 4rem;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-dim);
    margin-bottom: 1.5rem;
  }

  .hero__eyebrow::after {
    content: '_';
    display: inline-block;
    margin-left: 2px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__name {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 500;
    color: var(--fg);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .hero__headline {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    color: var(--accent);
    max-width: 60ch;
    margin-bottom: 1rem;
  }

  .hero__pitch {
    color: var(--fg-muted);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }

  .hero__focus {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .hero__focus li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }

  .hero__degree {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin-bottom: 2.5rem;
  }

  .hero__links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .hero__links a {
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 90vh;
      padding: 5rem 0 3rem;
    }
  }
</style>
