---
// Highlights: the three cards under the hero. Content lives in
// src/data/highlights.ts; this component only lays it out. Each item is
// media → title → plain blurb → optional note → <details> with the technical
// bullets → link. Media whose file is missing under public/ is skipped.
import { highlights } from '../data/highlights';
import { translations } from '../data/i18n';
import { pick } from '../data/localized';
import { mediaExists } from '../lib/media';

interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<!-- data-close / data-zoom: labels read by src/scripts/enhance.ts for the
     JS-only lightbox; the markup itself works without them. -->
<section id="highlights" aria-labelledby="highlights-heading" data-close={t.ui.close} data-zoom={t.ui.zoom}>
  <div class="container">
    <h2 id="highlights-heading">{t.sections.highlights}</h2>

    <ul class="grid">
      {
        highlights.map((h, i) => {
          const m = h.media;
          const isSvg = m.src.endsWith('.svg');
          return (
            <li class="item">
              {mediaExists(m.src) && (
                <figure
                  class:list={['media', { 'media--diagram': isSvg }]}
                  data-lightbox={i}
                  data-title={pick(h.title, lang)}
                >
                  {m.kind === 'video' ? (
                    <video
                      data-autoplay
                      controls
                      preload="none"
                      playsinline
                      poster={m.poster && mediaExists(m.poster) ? m.poster : undefined}
                      aria-label={pick(m.alt, lang)}
                    >
                      <source src={m.src} type="video/mp4" />
                    </video>
                  ) : (
                    <a href={m.src} target="_blank" rel="noopener" title={t.ui.zoom}>
                      <img src={m.src} alt={pick(m.alt, lang)} loading="lazy" decoding="async" />
                    </a>
                  )}
                </figure>
              )}
              {m.note && <p class="item__note">{pick(m.note, lang)}</p>}

              <h3 class="item__title">{pick(h.title, lang)}</h3>
              <p class="item__blurb">{pick(h.blurb, lang)}</p>

              <details>
                <summary>{t.ui.details}</summary>
                <ul class="item__details">
                  {h.details.map((d) => <li>{pick(d, lang)}</li>)}
                </ul>
              </details>

              {h.link && (
                <p class="item__link">
                  <a href={h.link.href} target="_blank" rel="noopener noreferrer">{pick(h.link.label, lang)}</a>
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Full-width tinted band: the most important block gets visual weight.
     Top padding comes from the global `section` rule; the margin keeps the
     card's breathing room white. */
  #highlights {
    margin-top: 40px;
    padding-bottom: 56px;
    background: #f6f7f9;
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 16:10 media box. Photos cover; the diagram and the (portrait) video fit
     whole on a neutral background so nothing is cropped. `position: relative`
     anchors the JS-added open button over the video. */
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: #f4f4f4;
    margin-bottom: 16px;
  }

  /* JS-only (enhance.ts): transparent button over the video, leaving the
     bottom 48px free for the native controls bar. */
  .media :global(.media__open) {
    position: absolute;
    inset: 0 0 48px;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .media :global(.media__open:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: -4px;
  }

  /* While the video autoplays (JS adds `media--live`) the Chromium/WebKit
     controls bar stays hidden until the box is hovered or holds focus.
     Firefox has no such pseudo-element and keeps its own auto-hiding bar. */
  .media--live > video::-webkit-media-controls {
    opacity: 0;
  }

  .media--live:hover > video::-webkit-media-controls,
  .media--live:focus-within > video::-webkit-media-controls {
    opacity: 1;
  }

  .media > a {
    display: block;
    height: 100%;
  }

  .media img,
  .media > video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media > video,
  .media--diagram img {
    object-fit: contain;
  }

  .media--diagram {
    background: #fff;
  }

  .media--diagram img {
    padding: 8px;
  }

  .item__title {
    font-size: 17px;
    margin-bottom: 8px;
  }

  .item__blurb {
    font-size: 16px;
  }

  /* Caption directly under the media box (e.g. "simulated screenshot"). */
  .item__note {
    font-size: 13px;
    color: var(--fg-2);
    margin: -8px 0 16px;
  }

  .item__details {
    font-size: 15px;
    padding-left: 20px;
    list-style: disc;
  }

  .item__details li + li {
    margin-top: 4px;
  }

  .item__link {
    margin-top: 8px;
  }
</style>
