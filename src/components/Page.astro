---
// The whole single-page site for one language. `/` renders <Page lang="en" />,
// `/pt/` renders <Page lang="pt" />. Switching language is a plain link to the
// other route — no client script.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Timeline from './Timeline.astro';
import Skills from './Skills.astro';
import Contact from './Contact.astro';
import { translations, type LangCode } from '../data/i18n';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = translations[lang];
const path = lang === 'pt' ? '/pt/' : '/';

// The one link to the other language, labelled in that language.
const other =
  lang === 'pt'
    ? { href: '/', hreflang: 'en', label: 'English' }
    : { href: '/pt/', hreflang: 'pt-BR', label: 'Português' };
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path={path}>
  <a class="skip-link" href="#timeline">{t.meta.skipLink}</a>

  <nav class="lang container" aria-label="Language">
    <a href={other.href} hreflang={other.hreflang} lang={other.hreflang}>{other.label}</a>
  </nav>

  <Hero lang={lang} />

  <main>
    <Timeline lang={lang} />
    <Skills lang={lang} />
    <Contact lang={lang} />
  </main>
</BaseLayout>

<style>
  /* Keyboard-only skip link — visible on focus, otherwise off-screen. */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 24px;
    background: #fff;
  }

  .skip-link:focus {
    top: 8px;
  }

  /* Language switch: one static text link at the top right of the column. */
  .lang {
    padding-top: 32px;
    text-align: right;
    font-size: 13px;
  }
</style>
