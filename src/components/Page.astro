---
// The whole single-page site for one language. `/` renders <Page lang="pt" />,
// `/en/` renders <Page lang="en" />. Order follows the six-second rule: who and
// what (masthead), proof (figures), then everything else in one-liners.
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from './Masthead.astro';
import Figures from './Figures.astro';
import Experience from './Experience.astro';
import MoreProjects from './MoreProjects.astro';
import Education from './Education.astro';
import Skills from './Skills.astro';
import { translations, type LangCode } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = translations[lang];
const path = lang === 'pt' ? '/' : '/en/';
const year = new Date().getFullYear();
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path={path}>
  <a class="skip-link" href="#projects">{t.meta.skipLink}</a>

  <Masthead lang={lang} />

  <main>
    <Figures lang={lang} />
    <Experience lang={lang} />
    <MoreProjects lang={lang} />
    <Education lang={lang} />
    <Skills lang={lang} />
  </main>

  <footer class="container">
    <div class="foot label">
      <span>© {year} {profile.shortName}</span>
      <a href="https://github.com/LuisPazzanese/luispazzanese.dev">{t.footer}</a>
    </div>
  </footer>
</BaseLayout>

<!-- The only client script: lightbox and muted autoplay of the figure video.
     Both are additive; the page is complete without it. -->
<script src="../scripts/enhance.ts"></script>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 24px;
    background: var(--paper);
  }

  .skip-link:focus {
    top: 8px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 72px;
    padding-top: 12px;
    padding-bottom: 32px;
    border-top: 1px solid var(--line);
  }

  .foot a {
    color: var(--muted);
  }

  .foot a:hover {
    color: var(--accent);
  }
</style>
