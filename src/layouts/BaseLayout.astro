---
// Document shell: <head> metadata + <body><slot/>. No scripts, no web fonts.
// Every page passes its language and route so canonical/hreflang/OG are static.
import '../styles/global.css';
import type { LangCode } from '../data/i18n';

interface Props {
  lang: LangCode;
  title: string;
  description: string;
  /** Site-relative route of this page, e.g. '/', '/pt/', '/404' */
  path: string;
}

const { lang, title, description, path } = Astro.props;

const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
const ogLocale = lang === 'pt' ? 'pt_BR' : 'en_US';

const canonicalURL = new URL(path, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();

// Language alternates: EN at '/', PT at '/pt/', x-default → EN.
const alternates = [
  { hreflang: 'en', href: new URL('/', Astro.site).toString() },
  { hreflang: 'pt-BR', href: new URL('/pt/', Astro.site).toString() },
  { hreflang: 'x-default', href: new URL('/', Astro.site).toString() },
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="luispazzanese.dev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luis Pazzanese — Computer Engineer · luispazzanese.dev" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon: tiny inline SVG, monospace 'w' -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ffffff'/%3E%3Ctext x='50%25' y='50%25' dy='.35em' text-anchor='middle' fill='%23000000' font-family='monospace' font-size='20' font-weight='500'%3Ew%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
